load("//bazel:yacl.bzl", "yacl_cc_binary")

package(default_visibility = ["//visibility:public"])

yacl_cc_binary(
    name = "fastpsi",
    srcs = [
        "bokvsv2.h",
        "bokvsv2.cc",
        "fastpsi.h",
        "fastpsi.cc",
        "galois128.h",
        "galois128.cc",
        "main.cc",
        "uint.h",
    ],
    deps = [
        "//yacl/base:int128",
        "//yacl/kernel/algorithms:silent_vole",
        "//yacl/link:test_util",
        "//yacl/utils:parallel",
        "//yacl/utils:platform_utils",
    ],
    copts = [
        "-std=c++20",
        "-maes",
        "-mpclmul",
        "-mavx2",
        "-mavx512f",
        "-mavx512bw",
        "-mavx512dq",
        "-fopenmp",
        "-O3",
        "-I/usr/local/include",
    ],
    linkopts = [
        "-L/usr/local/lib",
        "-lcryptoTools",
        "-fopenmp",
        "-O3",
    ],
)
